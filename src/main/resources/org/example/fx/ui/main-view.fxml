<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fx.ui.MainController"
            styleClass="app-root">
    <center>
        <TabPane side="TOP"
                 tabClosingPolicy="UNAVAILABLE"
                 styleClass="main-tabs">
            <tabs>
                <Tab text="Заявки">
                    <content>
                        <fx:include source="applications-view.fxml"/>
                    </content>
                </Tab>
                <Tab text="Слушатели">
                    <content>
                        <fx:include source="users-view.fxml"/>
                    </content>
                </Tab>
                <Tab text="Статистика">
                    <content>
                        <fx:include source="statistics-view.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="8" right="22" bottom="8" left="22"/>
            </padding>
            <Label fx:id="dbStatusLabel"
                   text="База данных: проверка подключения..."
                   styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Проверить подключение"
                    onAction="#handleCheckConnection"
                    styleClass="secondary-button"/>
        </HBox>
    </bottom>
</BorderPane>
